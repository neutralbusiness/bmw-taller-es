---
import Layout from "../layouts/Layout.astro";
import { NETWORK } from "../lib/network.ts";

/**
 * /zonas/ — página de descubrimiento del master (www).
 * Lista TODAS las ciudades activas agrupadas por provincia con enlace a su
 * subdominio. Es la ruta por la que Google descubre los ~561 subdominios
 * de la red desde un único documento enlazado en la home.
 */
interface CityRef {
  slug: string;
  name: string;
  province: string;
  ccaa: string;
}

const cityModules = import.meta.glob<{ default: CityRef }>("../content/cities/*.json", { eager: true });
const cities: CityRef[] = Object.values(cityModules).map(m => m.default);

// Agrupar por provincia (y anotar su CCAA para el subtítulo)
const byProvince: Record<string, { ccaa: string; cities: CityRef[] }> = {};
for (const c of cities) {
  if (!byProvince[c.province]) byProvince[c.province] = { ccaa: c.ccaa, cities: [] };
  byProvince[c.province].cities.push(c);
}
const provinces = Object.keys(byProvince).sort((a, b) => a.localeCompare(b, "es"));
for (const p of provinces) {
  byProvince[p].cities.sort((a, b) => a.name.localeCompare(b.name, "es"));
}

const totalCities = cities.length;
const canonical = `https://www.${NETWORK.domain}/zonas/`;
const title = `Zonas con taller BMW · ${totalCities} ciudades en España | ${NETWORK.brand}`;
const description = `Directorio completo de la red ${NETWORK.brand}: ${totalCities} ciudades con taller especializado BMW, agrupadas por provincia. Encuentra el tuyo y pide cita.`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: "es-ES",
      isPartOf: { "@id": `https://www.${NETWORK.domain}/#organization` },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: NETWORK.brand, item: `https://www.${NETWORK.domain}/` },
        { "@type": "ListItem", position: 2, name: "Zonas", item: canonical },
      ],
    },
  ],
};
---

<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <nav class="nav">
    <div class="container nav-inner">
      <a href="/" class="nav-brand">
        <span class="nav-brand-mark" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9v9a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V9"/><path d="M22 9 12 3 2 9l10 6Z"/></svg>
        </span>
        <span>{NETWORK.brand}</span>
      </a>
      <div class="nav-links">
        <a href="/">Inicio</a>
        <a href="#zonas">Zonas</a>
      </div>
      <a href={`tel:${NETWORK.phone}`} class="nav-cta" aria-label={`Llamar a ${NETWORK.phoneDisplay}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>{NETWORK.phoneDisplay}</span>
      </a>
    </div>
  </nav>

  <main id="main">
    <header class="zonas-hero">
      <div class="container">
        <span class="section-eyebrow">Red {NETWORK.brand}</span>
        <h1>Zonas con taller BMW</h1>
        <p class="zonas-lead">
          {totalCities} ciudades en España con taller especializado BMW de la red {NETWORK.brand}.
          Elige tu localidad para ver servicios, horario y contacto del taller que te atiende.
        </p>
      </div>
    </header>

    <section id="zonas" class="zonas-section">
      <div class="container">
        {provinces.map(prov => (
          <div class="zonas-prov">
            <div class="zonas-prov-head">
              <h2>{prov}</h2>
              <span class="zonas-prov-meta">{byProvince[prov].ccaa} · {byProvince[prov].cities.length} {byProvince[prov].cities.length === 1 ? "ciudad" : "ciudades"}</span>
            </div>
            <ul class="zonas-list">
              {byProvince[prov].cities.map(c => (
                <li>
                  <a href={`https://${c.slug}.${NETWORK.domain}/`} class="chip zonas-chip">Taller BMW en {c.name}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <div class="footer-legal" style="border-top: none; padding-top: 0;">
        <span>© {new Date().getFullYear()} {NETWORK.brand} · {NETWORK.email} · {NETWORK.phoneDisplay}</span>
        <div class="footer-legal-links">
          <a href="/">Inicio</a>
          <a href="/aviso-legal/">Aviso legal</a>
          <a href="/privacidad/">Privacidad</a>
          <a href="/llms.txt">llms.txt</a>
        </div>
      </div>
    </div>
  </footer>

  <style>
    .zonas-hero {
      background: var(--ink-900);
      color: white;
      padding: 4.5rem 0 3.5rem;
    }
    .zonas-hero h1 { color: white; margin-bottom: 0.75rem; }
    .zonas-hero .section-eyebrow { color: var(--amber-400); }
    .zonas-lead {
      font-size: 1.1rem;
      color: rgba(255, 255, 255, 0.82);
      max-width: 640px;
      margin: 0;
    }
    .zonas-section { padding-top: 3rem; }
    .zonas-prov { margin-bottom: 2.5rem; }
    .zonas-prov-head {
      display: flex;
      align-items: baseline;
      gap: 0.85rem;
      flex-wrap: wrap;
      border-bottom: 1px solid var(--border);
      padding-bottom: 0.6rem;
      margin-bottom: 1rem;
    }
    .zonas-prov-head h2 { font-size: 1.35rem; margin: 0; }
    .zonas-prov-meta { color: var(--ink-500); font-size: 0.85rem; font-weight: 600; }
    .zonas-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .zonas-chip {
      font-weight: 600;
      color: var(--ink-800);
      transition: border-color 130ms ease, background 130ms ease, color 130ms ease;
    }
    .zonas-chip:hover {
      border-color: var(--ink-900);
      background: var(--ink-900);
      color: white;
    }
  </style>
</Layout>
